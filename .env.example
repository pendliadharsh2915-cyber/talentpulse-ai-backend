# ==============================================================
# TalentPulse AI Backend - Environment Variable Configuration
# ==============================================================

# Server Port
PORT=8080

# Active Spring Profile ('dev' for H2 file database, 'prod' for PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Production PostgreSQL Database Credentials (used when SPRING_PROFILES_ACTIVE=prod)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobportal
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# JWT Security Configuration (HMAC-SHA256 256-bit Hex Key)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# File Upload Storage Directory
APP_UPLOAD_DIR=./uploads/resumes

# CORS Allowed Origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
